<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net9.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">36</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android'">35</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">34</SupportedOSPlatformVersion>
    <TargetPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">36</TargetPlatformVersion>
    <TargetPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android'">35</TargetPlatformVersion>
    <TargetPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">34</TargetPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="android-sdk.aar" />
    <None Remove="android-okhttp.aar" />
  </ItemGroup>
  <ItemGroup>
    <LinkerPreserve Include="Com.Bugfender.Sdk.Bugfender">
      <VisibleMembers>SetApiUrl;SetBaseUrl;Init;SetMaximumLocalStorageSize;EnableUIEventLogging;EnableCrashReporting;Log;ForceSendOnce;SendIssue;SendCrash;SendUserFeedback;SetNetworkLoggingEnabled;SetNetworkLoggingCaptureBodies;SetNetworkLoggingCaptureErrorResponseBodies;SetNetworkLoggingURLFilter;SetNetworkLoggingMaxRequestsPerMinute;SetNetworkLoggingRequestObfuscationHandler;SetNetworkLoggingResponseObfuscationHandler</VisibleMembers>
    </LinkerPreserve>
  </ItemGroup>
  <ItemGroup>
    <AndroidLibrary Include="android-sdk.aar" />
    <AndroidLibrary Include="android-okhttp.aar" Bind="false" />
    <AndroidMavenLibrary Include="com.squareup.okhttp3:okhttp" Version="4.12.0" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.squareup.okio:okio-jvm" Version="3.6.0" Bind="false" VerifyDependencies="false" />
    <AndroidJavaSource Include="Java\InstrumentedNetworkHelper.java" />
  </ItemGroup>
  <ItemGroup>
    <TransformFile Include="Transforms\*.xml" />
  </ItemGroup>
  <Import Project="..\Shared\Shared.projitems" Label="Shared" Condition="Exists('..\Shared\Shared.projitems')" />
</Project>
